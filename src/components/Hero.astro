---
import { getUi } from '../data/i18n';
import { getLocalizedPath } from '../data/i18n/routing';
import { defaultLocale, type LocaleCode } from '../data/i18n/locales';
import { siteConfig } from '../data/site';
import { rustHeroVideo } from '../data/rust';
import { heroPreloadSrc, heroSizes, heroSrcSet } from '../lib/responsive-images';

interface Props {
	accent?: string;
	subtitle?: string;
	subtitleShort?: string;
	heading?: string;
	locale?: LocaleCode;
}

const locale = Astro.props.locale ?? defaultLocale;
const ui = getUi(locale);

const {
	accent = ui.hero.accent,
	subtitle = ui.hero.subtitle,
	subtitleShort = ui.hero.subtitleShort,
} = Astro.props;

/** Exact Fortnite-style H1 lines — never derive from page SEO h1. */
const brandLine = siteConfig.name;
const featureLine = accent;

const buyUrl = siteConfig.checkoutUrl;
const featuresUrl = getLocalizedPath('features', locale);
---

<section class="hero" aria-label={ui.images.hero}>
	<div class="hero__media" aria-hidden="true">
		<picture class="hero__poster">
			<source media="(max-width: 760px)" srcset={heroPreloadSrc} type="image/webp" />
			<source
				media="(min-width: 761px)"
				srcset={heroSrcSet}
				sizes={heroSizes}
				type="image/webp"
			/>
			<img
				src={heroPreloadSrc}
				alt=""
				width="1600"
				height="900"
				class="hero__poster-img"
				fetchpriority="high"
				decoding="async"
			/>
		</picture>
		<video
			class="hero__video"
			data-rust-hacks-video="hero"
			src={rustHeroVideo.src}
			data-src={rustHeroVideo.src}
			autoplay
			muted
			loop
			playsinline
			webkit-playsinline
			preload="metadata"
			title={rustHeroVideo.title}
			aria-label={rustHeroVideo.ariaLabel}
		></video>
		<div class="hero__veil"></div>
	</div>

	<div class="hero__inner">
		<div class="hero__copy">
			<h1 class="hero__title">
				<span class="hero__brand">{brandLine}</span>
				<span class="hero__features">{featureLine}</span>
			</h1>
			<p class="hero__subtitle hero__subtitle--full">{subtitle}</p>
			<p class="hero__subtitle hero__subtitle--short">{subtitleShort}</p>
			<div class="hero__cta">
				<a href={buyUrl} class="btn-buy" rel="noopener noreferrer">
					{ui.hero.buyNow}
				</a>
				<a href={featuresUrl} class="hero__btn hero__btn--ghost">
					{ui.hero.seeFeatures}
				</a>
			</div>
		</div>
	</div>
</section>

<style>
	.hero {
		position: relative;
		overflow: hidden;
		isolation: isolate;
		/* First viewport: brand + one headline + one sentence + CTA + full-bleed media */
		min-height: clamp(420px, 72vh, 640px);
	}

	.hero__media {
		position: absolute;
		inset: 0;
		z-index: 0;
		background: #07040f;
	}

	.hero__poster,
	.hero__poster-img,
	.hero__video {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}

	.hero__poster {
		z-index: 1;
		margin: 0;
		display: block;
	}

	.hero__poster-img {
		object-fit: cover;
		object-position: 72% 42%;
		background: #07040f;
	}

	.hero__video {
		z-index: 1;
		object-fit: cover;
		object-position: 72% 42%;
		transform: translateZ(0) scale(1.04);
		backface-visibility: hidden;
		pointer-events: none;
		opacity: 0;
		background: transparent;
		transition: opacity 0.5s ease;
	}

	.hero__video.is-ready {
		opacity: 1;
	}

	@media (min-width: 761px) and (prefers-reduced-motion: no-preference) {
		.hero__video.is-ready {
			will-change: transform;
			animation: kenburns 20s ease-in-out infinite alternate;
		}
	}

	/* Strong left read plane so game UI / watermark text never fights the H1 */
	.hero__veil {
		position: absolute;
		inset: 0;
		z-index: 2;
		pointer-events: none;
		background:
			linear-gradient(
				90deg,
				rgba(7, 4, 15, 0.94) 0%,
				rgba(7, 4, 15, 0.78) 32%,
				rgba(7, 4, 15, 0.28) 58%,
				rgba(7, 4, 15, 0.45) 100%
			),
			linear-gradient(
				180deg,
				rgba(7, 4, 15, 0.35) 0%,
				transparent 40%,
				rgba(7, 4, 15, 0.72) 100%
			);
	}

	.hero__inner {
		position: relative;
		z-index: 3;
		display: flex;
		align-items: center;
		width: min(100% - (var(--page-gutter) * 2), var(--page-max));
		margin: 0 auto;
		padding: 5rem 0 3.75rem;
		min-height: inherit;
	}

	.hero__copy {
		max-width: min(36rem, 100%);
		min-width: 0;
		animation: rise-in 0.75s cubic-bezier(0.22, 1, 0.36, 1) both;
	}

	.hero__title {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(1.85rem, 4.6vw, 3.75rem);
		font-weight: 800;
		line-height: 1.12;
		letter-spacing: -0.03em;
		color: #fff;
		text-shadow: 0 8px 32px rgba(11, 13, 15, 0.7);
		display: flex;
		flex-direction: column;
		gap: 0.15em;
	}

	.hero__brand,
	.hero__features {
		display: block;
	}

	.hero__features {
		max-width: 18ch;
	}

	.hero__subtitle {
		margin: 1.15rem 0 0;
		max-width: 32rem;
		font-size: clamp(0.98rem, 1.45vw, 1.12rem);
		line-height: 1.55;
		font-weight: 500;
		color: rgba(255, 255, 255, 0.92);
		animation: rise-in 0.85s cubic-bezier(0.22, 1, 0.36, 1) 0.08s both;
	}

	.hero__cta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.85rem;
		margin-top: 1.65rem;
		animation: rise-in 0.85s cubic-bezier(0.22, 1, 0.36, 1) 0.14s both;
	}

	.hero__cta :global(.btn-buy) {
		box-shadow:
			0 0 0 1px rgba(192, 132, 252, 0.25),
			0 10px 28px rgba(124, 58, 237, 0.45),
			0 0 40px rgba(168, 85, 247, 0.28);
	}

	.hero__btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 3rem;
		padding: 0.85rem 1.35rem;
		border-radius: 0.85rem;
		font-size: 0.98rem;
		font-weight: 700;
		text-align: center;
		transition:
			transform 0.2s ease,
			background 0.2s ease,
			border-color 0.2s ease;
	}

	.hero__btn--ghost {
		border: 1px solid rgba(255, 255, 255, 0.55);
		background: rgba(8, 6, 14, 0.35);
		color: #fff;
	}

	.hero__btn--ghost:hover {
		border-color: rgba(255, 255, 255, 0.85);
		background: rgba(18, 14, 28, 0.55);
	}

	@keyframes rise-in {
		from {
			opacity: 0;
			transform: translateY(16px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes kenburns {
		from {
			transform: translateZ(0) scale(1.04) translate3d(0, 0, 0);
		}
		to {
			transform: translateZ(0) scale(1.1) translate3d(-1.2%, 0.8%, 0);
		}
	}

	.hero__subtitle--short {
		display: none;
	}

	@media (prefers-reduced-motion: reduce) {
		.hero__copy,
		.hero__subtitle,
		.hero__cta,
		.hero__video {
			animation: none;
		}

		.hero__video {
			display: none;
		}
	}

	@media (max-width: 760px) {
		.hero {
			min-height: min(78svh, 560px);
		}

		.hero__subtitle--full {
			display: none;
		}

		.hero__subtitle--short {
			display: block;
		}

		.hero__poster-img,
		.hero__video {
			object-position: center 30%;
		}

		.hero__video {
			animation: none;
			transform: none;
			will-change: auto;
		}

		.hero__veil {
			background:
				linear-gradient(180deg, rgba(7, 4, 15, 0.5) 0%, rgba(7, 4, 15, 0.28) 38%, rgba(7, 4, 15, 0.96) 100%),
				linear-gradient(90deg, rgba(7, 4, 15, 0.78), rgba(7, 4, 15, 0.35) 85%);
		}

		.hero__inner {
			align-items: flex-end;
			padding-top: calc(5rem + env(safe-area-inset-top, 0px));
			padding-bottom: 1.5rem;
		}

		.hero__copy {
			max-width: none;
			width: 100%;
			animation: none;
		}

		.hero__title {
			font-size: clamp(2rem, 9vw, 2.65rem);
			letter-spacing: -0.03em;
		}

		.hero__features {
			max-width: none;
		}

		.hero__subtitle,
		.hero__cta {
			animation: none;
		}

		.hero__subtitle--short {
			margin-top: 0.9rem;
			font-size: 0.95rem;
		}

		.hero__cta {
			flex-direction: column;
			align-items: stretch;
			gap: 0.65rem;
			margin-top: 1.25rem;
			width: 100%;
		}

		.hero__btn,
		.hero__cta :global(.btn-buy) {
			width: 100%;
			min-height: var(--touch-min);
		}
	}
</style>
